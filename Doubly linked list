struct node *deleteatbeg(struct node *head){
    
    struct node *ptr=head;
    struct node *nextnode=ptr->next;
    
    if(head==NULL){
        printf("Linked list is empty\n");
    }
    else{
        
        if(ptr->next==NULL){
            free(ptr);
            head=NULL;
        }
        else{
            head=nextnode;
            nextnode->prev=NULL;
            free(ptr);
        }
        
    }
    return head;
}

struct node *deleteatend(struct node *head){
    
    if(head==NULL)
    printf("linked list is empty\n");
    
    else{
    
    struct node *ptr=head;
    struct node *preptr=head;
    ptr=ptr->next;
    while(ptr->next!=NULL){
        
        ptr=ptr->next;
        preptr=preptr->next;
    }
    
    preptr->next=NULL;
    free(ptr);
}
return head;
}

struct node *deleteatpos(struct node *head){
    
    int pos;
    struct node *ptr=head;
    struct node *preptr=head;
    printf("enter a positions to delete\n");
    scanf("%d",&pos);
    
    if(pos==1){
        head=deleteatbeg(head);
    }
    else{
        ptr=ptr->next;
        int i=1;
        while(i<pos-1){
            ptr=ptr->next;
            preptr=preptr->next;
            i++;
        }
        preptr->next=ptr->next;
        ptr->next->prev=preptr;
        free(ptr);
        
    }
    return head;
    
    
}

struct node *insertatpos(struct node *head){
    int pos;
    struct node *ptr=head;
    struct node *preptr=head;
    printf("enter a positions to insert\n");
    scanf("%d",&pos);
    
    if(pos==1){
        head=insertatbeg(head);
    }
    else{
        
     int info;
     struct node *temp;
     temp=(struct node *)malloc(sizeof(struct node));
     printf("enter info\n");
     scanf("%d",&info);
     temp->data=info;
     temp->next=NULL;
     temp->prev=NULL;
     int i=1;
     while(i<pos){
        ptr=ptr->next;
        i++;
     }
     ptr->prev->next=temp;
     temp->prev=ptr->prev;
     temp->next=ptr;
     ptr->prev=temp;
        
    }
    
    return head;
    
    
}
