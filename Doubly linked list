struct node *create(struct node *head){
    int info;
    struct node *temp;
    struct node *ptr=head;
    temp=(struct node *)malloc(sizeof(struct node));
    printf("enter info\n");
    scanf("%d",&info);
    temp->data=info;
    temp->next=NULL;
    temp->prev=NULL;
    if(head==NULL){
        head=temp;
    }
    else{
        while(ptr->next!=NULL){
            ptr=ptr->next;
        }
        ptr->next=temp;
        temp->prev=ptr;
    }
    return head;
    
}

