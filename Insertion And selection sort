#include<stdio.h>
void merge(int arr[],int start,int mid,int end){
    
    int temp[100];
    int index=0;
    int i=start;
    int j=mid+1;
    while(i<=mid&&j<=end){
        if(arr[i]<arr[j]){
        temp[index++]=arr[i];
        i++;
            
        }
        else{
            temp[index++]=arr[j];
            j++;
        }
    }
    while(i<=mid){
        temp[index++]=arr[i];
        i++;
    }
    while(j<=end){
        temp[index++]=arr[j];
        j++;
    }
    index=0;
    for(int i=start;i<=end;i++){
        arr[i]=temp[index++];
    }
}
void merge_sort(int arr[],int start,int end){
    if(start<end){
    int mid=start+(end-start)/2;
    merge_sort(arr,start,mid);
    merge_sort(arr,mid+1,end);
    merge(arr,start,mid,end);
}
}



void selection_sort(int arr[],int n){
    for(int i=0;i<n-1;i++){
        int smallest=i;
        for(int j=i+1;j<n;j++){
            if(arr[j]<arr[smallest]){
                smallest=j;
            }
        }
        int temp=arr[i];
        arr[i]=arr[smallest];
        arr[smallest]=temp;
    }
}

void insertion_sort(int arr[],int n){
    for(int i=1;i<n;i++){
        int curr=arr[i];
        int prev=i-1;
        while(prev>=0&&arr[prev]>curr){
            arr[prev+1]=arr[prev];
            prev--;
        }
        arr[prev+1]=curr;
        
    }
}


int seperate(int arr[],int st,int end)
{
    int index=st-1;
    int pivot=arr[end];
    for(int j=st;j<end;j++){
        if(arr[j]<pivot){
            index++;
            int temp=arr[index];
            arr[index]=arr[j];
            arr[j]=temp;
        }
        
    }
    index++;
    int temp=arr[end];
    arr[end]=arr[index];
    arr[index]=temp;
    
    return index;
}

void quick_sort(int arr[],int start,int end){
    if(start<end){
        int PvtIndex=seperate(arr,start,end);
        quick_sort(arr,start,PvtIndex-1);
        quick_sort(arr,PvtIndex+1,end);
    }
}


