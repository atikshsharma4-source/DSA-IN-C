#include<stdio.h>
int seperate(int arr[],int start,int end){
    int index=start-1;
    for(int j=start;j<end;j++){
        if(arr[j]<arr[end]){
            index++;
            int temp=arr[index];
            arr[index]=arr[j];
            arr[j]=temp;
        }
    }
    index++;
    int temp=arr[end];
    arr[end]=arr[index];
    arr[index]=temp;
    return index;
}
void quick_sort(int arr[],int start,int end){
    if(start<end){
        int pindx=seperate(arr,start,end);
        quick_sort(arr,start,pindx-1);
        quick_sort(arr,pindx+1,end);
    }
}
int main(){
    int arr[]={1,5,6,8,2,3,5};
    quick_sort(arr,0,6);
    for(int i=0;i<7;i++){
        printf("%d",arr[i]);
    }
    return 0;

}
